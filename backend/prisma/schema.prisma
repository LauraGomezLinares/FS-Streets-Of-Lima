// Schema de base de datos relacional (Requerimiento 1)
// Corre: npx prisma migrate dev --name init   (después de configurar DATABASE_URL en .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // cambia a "mysql" si usas MySQL
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  role          Role     @default(PLAYER)
  isBanned      Boolean  @default(false)
  createdAt     DateTime @default(now())

  // OTP (Requerimiento 4)
  otpCode       String?
  otpExpiresAt  DateTime?
  otpVerified   Boolean  @default(false)

  // Relaciones
  battlePass    BattlePassProgress?
  purchases     Purchase[]
  friendsOf     Friendship[] @relation("UserFriends")
  friendOf      Friendship[] @relation("FriendOfUser")
  loginLogs     LoginLog[]
}

model Character {
  id          String   @id @default(uuid())
  name        String
  rarity      String
  price       Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  purchases   Purchase[]
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  characterId String
  pricePaid   Int
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  character   Character @relation(fields: [characterId], references: [id])
}

model BattlePassProgress {
  id              String   @id @default(uuid())
  userId          String   @unique
  level           Int      @default(1)
  xp              Int      @default(0)
  claimedLevels   Int[]    @default([])
  isPremium       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id          String       @id @default(uuid())
  userId      String
  friendId    String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  user        User @relation("UserFriends", fields: [userId], references: [id])
  friend      User @relation("FriendOfUser", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

// Requerimiento 7: trazabilidad de accesos (especialmente admin)
model LoginLog {
  id          String   @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  success     Boolean
  isAdminLogin Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
}
