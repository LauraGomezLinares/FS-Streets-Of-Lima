# Copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo ".env" real a GitHub (agrégalo a .gitignore).

# --- Base de datos ---
# Ejemplo para PostgreSQL (puedes usar Railway, Render, Supabase, Neon, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/streets_of_lima?schema=public"

# --- Servidor ---
PORT=4000
FRONTEND_URL="http://localhost:3000"

# --- JWT ---
JWT_SECRET="cambia-esto-por-un-string-largo-y-random"
JWT_EXPIRES_IN="2h"
ADMIN_JWT_EXPIRES_IN="30m"

# --- OTP por correo (usando Gmail como ejemplo) ---
# Si usas Gmail necesitas crear una "App Password" (no tu contraseña normal):
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_app_password_de_16_caracteres"
OTP_EXPIRES_MINUTES=5
